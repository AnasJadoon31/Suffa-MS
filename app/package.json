  "dependencies": {
    "@tanstack/react-query": "^5.62.8",
    "axios": "^1.18.1",
    "dexie": "^4.0.10",
    "i18next": "^24.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.18.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "ts-morph": "^28.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
