    "test:snackbar": "node scripts/verify-snackbar.mjs",
    "test:document-uploads": "node scripts/verify-document-uploads.mjs",
    "test:date-ranges": "node --experimental-strip-types scripts/check-date-ranges.mjs",
    "test:admission-builder": "node scripts/check-admission-form-builder.mjs",
    "test:assessment-errors": "node scripts/check-assessment-errors.mjs",
    "test:action-menu": "node scripts/verify-action-menu.mjs",
    "test:foundation-components": "node scripts/verify-foundation-components.mjs",
    "test:audience-picker": "node scripts/verify-audience-picker.mjs",
    "test:salary-history": "node scripts/verify-salary-history.mjs",
    "test:my-timetable": "node scripts/verify-my-timetable.mjs",
    "test:attendance-defaults": "node scripts/verify-attendance-defaults.mjs",
    "test:my-assessments": "node scripts/verify-my-assessments.mjs",
    "test:assignment-batch": "node scripts/verify-assignment-batch.mjs",
    "test:forms-responses": "node scripts/verify-forms-responses.mjs",
    "test:credential-links": "node scripts/verify-credential-links.mjs",
    "test:report-ranges": "node scripts/verify-report-ranges.mjs",
    "test:finance-profiles": "node scripts/verify-finance-profiles.mjs",
    "test:students-layout": "node scripts/verify-students-layout.mjs",
    "test:phone-inputs": "node scripts/verify-phone-inputs.mjs",
    "test:whatsapp-connection": "node scripts/verify-whatsapp-connection.mjs",
    "test:visual-issues": "node scripts/verify-current-issues.mjs",
    "test:live-seed": "node scripts/seed-live-verification.mjs",
    "test:live-roles": "node scripts/verify-live-roles.mjs",
    "test:guardian-dashboard": "node scripts/verify-guardian-dashboard.mjs",
